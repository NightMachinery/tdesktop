; Built-in Purple Desktop keymap (shared evilify EDN format).
; Local ~/.purple-telegram/keys.edn overlays this file: an entry there
; replaces the matching chord in the same map, and nil removes it.
;
; Rules: every command has a home in a Doom-aligned SPC group, a Vim prefix
; (g, y, [, ], C-w), or a context map after the localleader ("," or "SPC m").
; Short keys reuse their group letter and never commit irreversible actions.
{:localleader ["," "SPC m"]

 :normal
 {; Prefix labels for which-key and the status line.
  "SPC"   "leader"
  "SPC b" "buffer / chat"
  "SPC o" "open"
  "SPC n" "new"
  "SPC p" "playback"
  "SPC s" "search"
  "SPC t" "toggle"
  "SPC w" "window"
  "SPC a" "accounts"
  "SPC h" "help"
  "g"     "go / hints"
  "y"     "yank"
  "["     "previous"
  "]"     "next"
  "C-w"   "window"

  ; Mode, help, and command palette.
  "i"       :enter-insert-mode
  "a"       :enter-insert-mode
  "C-["     :enter-normal-mode
  "?"       :cheatsheet
  "SPC ?"   :keys-help
  "SPC h c" :cheatsheet
  "SPC h b" :keys-help
  "SPC h k" :key-describe
  "SPC h f" :command-describe
  "SPC h s" :stock-shortcuts
  "SPC h r" :reload-keymap
  ":"       :command-search
  "M-x"     :command-search
  "SPC :"   :command-search
  "SPC SPC" :command-search
  "SPC ,"   :chat-palette
  "SPC RET" :chat-palette
  "SPC u"   :unread-chats-buffer
  "SPC z"   :toggle-privacy-screen
  "SPC b b" :chat-palette
  "SPC b I" :unread-chats-buffer

  ; Navigation and scrolling.
  "j"       :move-down
  "k"       :move-up
  "J"       :chat-cursor-next
  "K"       :chat-cursor-previous
  "C-j"     :chat-cursor-next
  "C-k"     :chat-cursor-previous
  "RET"     :chat-cursor-open
  "o"       :chat-cursor-open
  "l"       :focus-conversation
  "h"       :focus-chat-list
  "C-d"     :history-half-down
  "C-u"     :history-half-up
  "C-f"     :history-page-newer
  "C-b"     :history-page-older
  "G"       :history-jump-to-latest
  "g g"     :history-page-older
  "[ c"     :chat-cursor-previous
  "] c"     :chat-cursor-next
  "[ f"     :folder-previous
  "] f"     :folder-next
  "[ m"     :history-page-older
  "] m"     :history-page-newer
  "] ]"     :history-jump-to-latest
  "] u"     :history-jump-to-unread
  "[ t"     :playback-previous-track
  "] t"     :playback-next-track

  ; Search and quick URL hint.
  "/"       :search-messages
  "f"       :message-hint-open-url
  "SPC s s" :search-messages
  "SPC s c" :chat-palette

  ; g: go and visible message hints.
  "g s"     :message-hint-select
  "g m"     :message-hint-menu
  "g r"     :message-hint-reply
  "g e"     :message-hint-edit
  "g o"     :message-hint-open-url
  "g u"     :history-jump-to-unread

  ; y: yank / copy (all copyable artifacts live under y).
  "y y"     :message-hint-copy-text
  "y m"     :message-hint-copy-text
  "y l"     :message-hint-copy-link
  "y u"     :message-hint-copy-url

  ; SPC b: buffer / active chat.
  "SPC b i" :open-chat-info
  "SPC b m" :open-chat-menu
  "SPC b p" :open-pinned-messages
  "SPC b v" :preview-chat
  "SPC b s" :open-scheduled-messages
  "SPC b d" :history-open-calendar
  "SPC b u" :attach-files
  "SPC b w" :chat-backgrounds-visibility-toggle

  ; SPC o: open views and panels.
  "SPC o s" :open-settings
  "SPC o S" :open-saved-messages
  "SPC o a" :open-archived-chats
  "SPC o c" :open-contacts
  "SPC o p" :open-calls
  "SPC o d" :open-downloads
  "SPC o m" :open-main-menu
  "SPC o u" :open-music
  "SPC o l" :open-playlists

  ; SPC n: new / create.
  "SPC n g" :new-group
  "SPC n c" :new-channel
  "SPC n p" :add-contact

  ; SPC p: playback and music.
  "SPC p p" :playback-toggle
  "SPC p s" :playback-stop
  "SPC p n" :playback-next-track
  "SPC p N" :playback-previous-track
  "SPC p f" :playback-seek-forward
  "SPC p b" :playback-seek-backward
  "SPC p m" :open-music
  "SPC p l" :open-playlists

  ; SPC t: toggles.
  "SPC t b" :chat-backgrounds-visibility-toggle
  "SPC t n" :toggle-night-mode
  "SPC t z" :toggle-chat-zen-mode
  "SPC t p" :toggle-privacy-screen

  ; SPC w and C-w: panes.
  "SPC w h" :focus-chat-list
  "SPC w l" :focus-conversation
  "SPC w w" :focus-other-pane
  "SPC w m" :toggle-chat-zen-mode
  "C-w h"   :focus-chat-list
  "C-w l"   :focus-conversation
  "C-w w"   :focus-other-pane

  ; SPC a: accounts.
  "SPC a 1" :switch-account-1
  "SPC a 2" :switch-account-2
  "SPC a 3" :switch-account-3
  "SPC a 4" :switch-account-4
  "SPC a 5" :switch-account-5
  "SPC a 6" :switch-account-6}

 ; Context maps: typed after localleader ("," or "SPC m").
 :chat
 {"i" :open-chat-info
  "m" :open-chat-menu
  "p" :open-pinned-messages
  "s" :open-scheduled-messages
  "d" :history-open-calendar
  "a" :attach-files
  "r" :message-hint-reply
  "e" :message-hint-edit
  "v" :open-chat-media
  "u" :open-chat-music
  "f" :open-chat-files
  "l" :open-chat-links
  "o" :open-chat-voice
  "g" :open-chat-gifs
  "q" :open-chat-polls}

 :chats
 {"p" :preview-chat
  "m" :open-chat-menu
  "a" :open-archived-chats
  "f" :folder-next
  "F" :folder-previous}

 :music
 {"p" :playback-toggle
  "s" :playback-stop
  "n" :playback-next-track
  "N" :playback-previous-track
  "f" :playback-seek-forward
  "b" :playback-seek-backward
  "l" :open-playlists}

 :insert
 {"C-[" :enter-normal-mode
  "M-x" :command-search}}
